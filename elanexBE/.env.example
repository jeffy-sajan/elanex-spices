DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081

# Use the Supabase connection string in deployed environments.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Server-only credentials for product image uploads from Django admin.
# Create a public Supabase Storage bucket with this name before uploading images.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# SUPABASE_STORAGE_BUCKET=product-images

# Resend contact-form email delivery. CONTACT_FROM_EMAIL must be a verified
# sender/domain in Resend.
# RESEND_API_KEY=re_replace-with-server-only-api-key
# CONTACT_FROM_EMAIL=website@your-verified-domain.com
# CONTACT_RECIPIENT_EMAIL=elanexspices@gmail.com
